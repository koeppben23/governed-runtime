{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "coverageAnalysis": "all",
  "checkers": [],
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.stryker-topology.config.ts",
    "related": false
  },
  "mutate": ["src/machine/topology.ts"],
  "mutator": {
    "excludedMutations": ["Regex"]
  },
  "ignoreStatic": false,
  "thresholds": {
    "high": 95,
    "low": 80,
    "break": 80
  },
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "concurrency": 2,
  "tempDirName": ".stryker-tmp-topology",
  "jsonReporter": {
    "fileName": "reports/mutation/topology/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/topology/mutation.html"
  }
}
