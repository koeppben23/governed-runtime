diff --git a/packages/schema/src/config/host.ts b/packages/schema/src/config/host.ts
new file mode 100644
index 0000000..c31a598
--- /dev/null
+++ b/packages/schema/src/config/host.ts
@@ -0,0 +1,63 @@
+export * as ConfigHost from "./host.js"
+
+import { Schema } from "effect"
+import { optional } from "../schema.js"
+
+/** A required plugin's trusted source identity, optionally tied to its ID. */
+export const RequiredPluginSource = Schema.Union([
+  Schema.Struct({ type: Schema.Literal("local"), path: Schema.String }),
+  Schema.Struct({
+    type: Schema.Literal("package"),
+    target: Schema.String,
+    version: Schema.String.pipe(optional),
+  }),
+  Schema.Struct({ type: Schema.Literal("builtin") }),
+  Schema.Struct({ type: Schema.Literal("sdk") }),
+]).annotate({ identifier: "Config.RequiredPluginSource" })
+export type RequiredPluginSource = typeof RequiredPluginSource.Type
+
+export const RequiredPlugin = Schema.Union([
+  Schema.String,
+  Schema.Struct({
+    id: Schema.String,
+    source: RequiredPluginSource.pipe(optional).annotate({
+      description: "Trusted source identity for the active plugin. Omit to require only the ID.",
+    }),
+  }),
+]).annotate({ identifier: "Config.RequiredPlugin" })
+export type RequiredPlugin = typeof RequiredPlugin.Type
+
+/** A provider rule may pin the endpoint and the transport that may carry its requests. */
+export const ProviderRule = Schema.Union([
+  Schema.String,
+  Schema.Struct({
+    id: Schema.String,
+    package: Schema.String.pipe(optional).annotate({
+      description: "Provider package that must supply the runtime implementation.",
+    }),
+    baseURL: Schema.String.pipe(optional).annotate({
+      description: "Allowed endpoint origin and path prefix for this provider.",
+    }),
+    transports: Schema.Array(Schema.Literals(["http", "websocket"]))
+      .pipe(optional)
+      .annotate({
+        description: "Transports this provider may use. Omit to allow both.",
+      }),
+  }),
+]).annotate({ identifier: "Config.ProviderRule" })
+export type ProviderRule = typeof ProviderRule.Type
+
+/**
+ * Host-enforced provider execution limits. A host policy may narrow which
+ * providers can run and whether provider-hosted tools are allowed. The shape is
+ * intentionally small: provider-hosted tool execution happens outside the local
+ * tool pipeline, so the host must reject the request before it leaves.
+ */
+export class ProviderExecution extends Schema.Class<ProviderExecution>("Config.ProviderExecution")({
+  allowedProviders: Schema.Array(ProviderRule).pipe(optional).annotate({
+    description: "Provider IDs or endpoint/transport rules allowed to receive model requests.",
+  }),
+  hostedTools: Schema.Literals(["allow", "deny"]).pipe(optional).annotate({
+    description: "Whether provider-hosted tool definitions are allowed. A configured policy defaults to deny.",
+  }),
+}) {}
