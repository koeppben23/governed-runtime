diff --git a/packages/core/src/host-policy.ts b/packages/core/src/host-policy.ts
new file mode 100644
index 0000000..ac6319e
--- /dev/null
+++ b/packages/core/src/host-policy.ts
@@ -0,0 +1,411 @@
+export * as HostPolicy from "./host-policy.js"
+
+import { ConfigHost } from "@opencode/schema/config/host"
+import { FSUtil } from "@opencode/util/fs-util"
+import { makeLocationNode } from "@opencode/util/effect/app-node"
+import { Context, Effect, Layer, Option, Schema } from "effect"
+import { Config } from "./config.js"
+import { ConfigManaged } from "./config/managed.js"
+import { Plugin } from "./plugin/service.js"
+
+/**
+ * A host policy is a small, deployment-owned contract. It must not be read from
+ * project or SDK configuration: those layers can request or describe work, but
+ * they cannot decide whether the host is allowed to execute it.
+ */
+const FilePolicy = Schema.Struct({
+  requiredPlugins: Schema.Array(ConfigHost.RequiredPlugin).pipe(Schema.optional),
+  providerExecution: ConfigHost.ProviderExecution.pipe(Schema.optional),
+})
+type FilePolicy = typeof FilePolicy.Type
+
+type ProviderRule = {
+  readonly id: string
+  readonly package?: string
+  readonly baseURL?: string
+  readonly transports?: readonly ("http" | "websocket")[]
+}
+
+type ProviderPolicy = {
+  readonly allowedProviders?: readonly ProviderRule[]
+  readonly hostedTools: "allow" | "deny"
+}
+
+export type Policy = {
+  readonly requiredPlugins: readonly ConfigHost.RequiredPlugin[]
+  readonly provider: ProviderPolicy | undefined
+}
+
+export class DeniedError extends Schema.TaggedError<DeniedError>()("HostPolicy.DeniedError", {
+  code: Schema.String,
+  reason: Schema.String,
+  recovery: Schema.optional(Schema.Array(Schema.String)),
+}) {}
+
+export interface Interface {
+  /** Fail-closed before any governed model, command, shell, or tool action. */
+  readonly assertExecutionAllowed: () => Effect.Effect<void, never, Plugin.Service>
+  /** Fail-closed before the final provider request leaves the host. */
+  readonly assertProviderRequest: (
+    input: {
+      readonly providerID: string
+      readonly package?: string
+      readonly url: string
+      readonly body: string
+      readonly transport: "http" | "websocket"
+    },
+    plugins?: Plugin.Interface,
+  ) => Effect.Effect<void>
+  /** Authorize and run the provider send under an activation lease. */
+  readonly withProviderSend: <A, E, R>(
+    input: {
+      readonly providerID: string
+      readonly package?: string
+      readonly url: string
+      readonly body: string
+      readonly transport: "http" | "websocket"
+    },
+    plugins: Plugin.Interface | undefined,
+    send: Effect.Effect<A, E, R>,
+  ) => Effect.Effect<A, E, R>
+}
+
+export class Service extends Context.Service<Service, Interface>()("@opencode/HostPolicy") {}
+
+const HOSTED_TOOL_KEYS = new Set([
+  "googleSearch",
+  "googleSearchRetrieval",
+  "urlContext",
+  "codeExecution",
+  "computerUse",
+  "bash",
+  "textEditor",
+])
+
+const HOSTED_TOOL_TYPES = new Set([
+  "web_search",
+  "web_search_preview",
+  "web_search_20250305",
+  "web_extractor",
+  "file_search",
+  "file_search_call",
+  "code_interpreter",
+  "code_interpreter_call",
+  "code_execution",
+  "code_execution_20250522",
+  "code_execution_call",
+  "image_generation",
+  "image_generation_call",
+  "computer_use",
+  "computer_20250124",
+  "bash_20250124",
+  "text_editor_20250124",
+  "server_tool_use",
+  "web_search_call",
+])
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value)
+
+function denied(code: string, reason: string, recovery?: readonly string[]) {
+  return new DeniedError({ code, reason, ...(recovery ? { recovery } : {}) })
+}
+
+function mergeProvider(policies: readonly (FilePolicy["providerExecution"] | undefined)[]): ProviderPolicy | undefined {
+  const present = policies.filter((policy) => policy !== undefined)
+  if (present.length === 0) return undefined
+  const normalize = (rule: ConfigHost.ProviderRule): ProviderRule => (typeof rule === "string" ? { id: rule } : rule)
+  const declared = present.flatMap((policy) => (policy.allowedProviders ?? []).map(normalize))
+  const restricted = present.some((policy) => policy.allowedProviders !== undefined)
+  const ids = Array.from(new Set(declared.map((rule) => rule.id)))
+  const allowedProviders = restricted
+    ? ids.flatMap((id) => {
+        if (
+          !present.every(
+            (policy) =>
+              policy.allowedProviders === undefined ||
+              policy.allowedProviders.some((rule) => (typeof rule === "string" ? rule : rule.id) === id),
+          )
+        )
+          return []
+        const rules = declared.filter((rule) => rule.id === id)
+        const packages = Array.from(new Set(rules.flatMap((rule) => (rule.package ? [rule.package] : []))))
+        const baseURLs = Array.from(new Set(rules.flatMap((rule) => (rule.baseURL ? [rule.baseURL] : []))))
+        const transports = rules.some((rule) => rule.transports !== undefined)
+          ? rules
+              .flatMap((rule) => rule.transports ?? [])
+              .filter(
+                (transport) =>
+                  !rules.some((rule) => rule.transports !== undefined && !rule.transports.includes(transport)),
+              )
+              .filter((transport, index, all) => all.indexOf(transport) === index)
+          : undefined
+        return [
+          {
+            id,
+            ...(packages.length === 1
+              ? { package: packages[0] }
+              : packages.length > 1
+                ? { package: "__host_policy_conflict__" }
+                : {}),
+            ...(baseURLs.length === 1
+              ? { baseURL: baseURLs[0] }
+              : baseURLs.length > 1
+                ? { baseURL: "__host_policy_conflict__" }
+                : {}),
+            ...(transports === undefined ? {} : { transports }),
+          },
+        ]
+      })
+    : undefined
+  const hostedTools = present.some((policy) => policy.hostedTools !== "allow") ? "deny" : "allow"
+  return { ...(allowedProviders ? { allowedProviders } : {}), hostedTools }
+}
+
+const effectivePort = (url: URL) => url.port || (url.protocol === "https:" || url.protocol === "wss:" ? "443" : "80")
+
+function matchesEndpoint(input: string, baseURL: string) {
+  let request: URL
+  let base: URL
+  try {
+    request = new URL(input)
+    base = new URL(baseURL)
+  } catch {
+    return false
+  }
+  if (request.hostname !== base.hostname || effectivePort(request) !== effectivePort(base)) return false
+  // Never let an allowed secure endpoint degrade to its cleartext variant, even on
+  // the same explicit port. A secure base may carry the matching secure upgrade.
+  const protocolMatches =
+    base.protocol === "https:"
+      ? request.protocol === "https:" || request.protocol === "wss:"
+      : base.protocol === "wss:"
+        ? request.protocol === "wss:"
+        : base.protocol === "http:"
+          ? request.protocol === "http:" || request.protocol === "ws:"
+          : base.protocol === "ws:"
+            ? request.protocol === "ws:"
+            : false
+  if (!protocolMatches) return false
+  const basePath = base.pathname.replace(/\/+$/, "")
+  const requestPath = request.pathname
+  return requestPath === basePath || requestPath.startsWith(`${basePath}/`)
+}
+
+function hostedToolDefinition(value: Record<string, unknown>) {
+  if (!Array.isArray(value.tools)) return
+  for (const [index, tool] of value.tools.entries()) {
+    if (!isRecord(tool)) continue
+    if (typeof tool.type === "string" && tool.type !== "function" && tool.type !== "custom")
+      return `tools[${index}].type=${tool.type}`
+    for (const key of HOSTED_TOOL_KEYS) if (key in tool) return `tools[${index}].${key}`
+  }
+}
+
+function hostedCall(value: unknown, path: string, depth: number): string | undefined {
+  if (depth > 8) return
+  if (Array.isArray(value)) {
+    for (const [index, item] of value.entries()) {
+      const found = hostedCall(item, `${path}[${index}]`, depth + 1)
+      if (found) return found
+    }
+    return
+  }
+  if (!isRecord(value)) return
+  if (typeof value.type === "string" && HOSTED_TOOL_TYPES.has(value.type)) return `${path}.type=${value.type}`
+  for (const [key, child] of Object.entries(value)) {
+    if (key === "tools") continue
+    const found = hostedCall(child, path === "" ? key : `${path}.${key}`, depth + 1)
+    if (found) return found
+  }
+}
+
+function inspectProviderBody(body: string) {
+  if (body.length === 0) return
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(body)
+  } catch {
+    return "provider request body is not valid JSON"
+  }
+  if (!isRecord(parsed)) return
+  return hostedToolDefinition(parsed) ?? hostedCall(parsed, "", 0)
+}
+
+export const layer = Layer.effect(
+  Service,
+  Effect.gen(function* () {
+    const config = yield* Config.Service
+    const fs = yield* FSUtil.Service
+
+    // The policy file is opt-in host configuration. A configured but unreadable
+    // or malformed file is a startup defect, never an implicit allow.
+    const file = yield* Effect.gen(function* () {
+      const path = process.env.OPENCODE_HOST_POLICY
+      if (!path) return
+      const text = yield* fs.readFileStringSafe(path).pipe(Effect.orDie)
+      if (text === undefined) return yield* Effect.die(new Error(`Host policy file is missing or unreadable: ${path}`))
+      const decoded = Schema.decodeUnknownOption(Schema.fromJsonString(FilePolicy))(text)
+      if (Option.isNone(decoded)) return yield* Effect.die(new Error(`Host policy file is invalid: ${path}`))
+      return decoded.value
+    })
+
+    const currentPolicy = Effect.fn("HostPolicy.currentPolicy")(function* () {
+      const entries = yield* config.entries()
+      const managed = entries.filter(
+        (entry): entry is ConfigManaged.Document => entry instanceof ConfigManaged.Document,
+      )
+      const requiredPlugins = Array.from(
+        new Map(
+          [...(file?.requiredPlugins ?? []), ...managed.flatMap((entry) => entry.info.requiredPlugins ?? [])].map(
+            (entry) => {
+              const normalized = typeof entry === "string" ? { id: entry } : entry
+              return [JSON.stringify([normalized.id, normalized.source ?? null]), normalized] as const
+            },
+          ),
+        ).values(),
+      )
+      return {
+        requiredPlugins,
+        provider: mergeProvider([file?.providerExecution, ...managed.map((entry) => entry.info.providerExecution)]),
+      } satisfies Policy
+    })
+
+    const requirePlugins = (plugins: Plugin.Interface, selectors: readonly ConfigHost.RequiredPlugin[]) =>
+      plugins
+        .requireActive(selectors.map((selector) => (typeof selector === "string" ? { id: selector } : selector)))
+        .pipe(
+          Effect.catchTag("Plugin.RequiredPluginError", (error) =>
+            Effect.die(
+              denied("REQUIRED_PLUGIN_INACTIVE", error.message, [
+                "Activate the required plugin generation and retry.",
+                "Check the host log for plugin setup or transform failures.",
+              ]),
+            ),
+          ),
+        )
+
+    const assertExecutionAllowed = Effect.fn("HostPolicy.assertExecutionAllowed")(function* () {
+      const plugins = yield* Plugin.Service
+      const current = yield* currentPolicy()
+      yield* requirePlugins(plugins, current.requiredPlugins)
+    })
+
+    const assertProviderRequest = Effect.fn("HostPolicy.assertProviderRequest")(function* (
+      input: {
+        readonly providerID: string
+        readonly package?: string
+        readonly url: string
+        readonly body: string
+        readonly transport: "http" | "websocket"
+      },
+      plugins?: Plugin.Interface,
+    ) {
+      const current = yield* currentPolicy()
+      if (current.requiredPlugins.length > 0 && plugins === undefined)
+        return yield* Effect.die(
+          denied(
+            "REQUIRED_PLUGIN_CONTEXT_MISSING",
+            "A required-plugin policy is active but the provider path has no plugin service.",
+            ["Run the provider request inside the governed location context."],
+          ),
+        )
+      if (plugins) yield* requirePlugins(plugins, current.requiredPlugins)
+      const provider = current.provider
+      if (!provider) return
+      if (provider.allowedProviders) {
+        const rules = provider.allowedProviders.filter((rule) => rule.id === input.providerID)
+        if (rules.length === 0)
+          return yield* Effect.die(
+            denied("PROVIDER_NOT_ALLOWED", `Provider ${input.providerID} is not allowed by the host policy.`, [
+              "Use a provider listed in the host providerExecution policy.",
+            ]),
+          )
+        for (const rule of rules) {
+          if (rule.package && rule.package !== input.package)
+            return yield* Effect.die(
+              denied(
+                "PROVIDER_IMPLEMENTATION_NOT_ALLOWED",
+                `Provider ${input.providerID} uses ${input.package ?? "an unknown package"}, outside ${rule.package}.`,
+                ["Use the provider package pinned by the provider rule."],
+              ),
+            )
+          if (rule.transports && !rule.transports.includes(input.transport))
+            return yield* Effect.die(
+              denied("PROVIDER_TRANSPORT_NOT_ALLOWED", `Provider ${input.providerID} may not use ${input.transport}.`, [
+                "Use a transport permitted by the provider rule.",
+              ]),
+            )
+          if (rule.baseURL && !matchesEndpoint(input.url, rule.baseURL))
+            return yield* Effect.die(
+              denied(
+                "PROVIDER_ENDPOINT_NOT_ALLOWED",
+                `Provider ${input.providerID} requested ${input.url || "(unknown endpoint)"}, outside ${rule.baseURL}.`,
+                ["Use the endpoint pinned by the provider rule."],
+              ),
+            )
+        }
+      }
+      if (provider.hostedTools === "allow") return
+      const found = inspectProviderBody(input.body)
+      if (found)
+        return yield* Effect.die(
+          denied(
+            "HOSTED_TOOL_NOT_ALLOWED",
+            `Provider-hosted tool execution is not allowed (${found}, ${input.transport}).`,
+            ["Remove the hosted tool definition or use a provider without provider-executed tools."],
+          ),
+        )
+    })
+
+    const withProviderSend = <A, E, R>(
+      input: {
+        readonly providerID: string
+        readonly package?: string
+        readonly url: string
+        readonly body: string
+        readonly transport: "http" | "websocket"
+      },
+      plugins: Plugin.Interface | undefined,
+      send: Effect.Effect<A, E, R>,
+    ) =>
+      Effect.gen(function* () {
+        yield* assertProviderRequest(input, plugins)
+        const current = yield* currentPolicy()
+        if (current.requiredPlugins.length === 0) return yield* send
+        if (plugins === undefined)
+          return yield* Effect.die(
+            denied(
+              "REQUIRED_PLUGIN_CONTEXT_MISSING",
+              "A required-plugin policy is active but the provider path has no plugin service.",
+              ["Run the provider request inside the governed location context."],
+            ),
+          )
+        return yield* plugins
+          .withActive(
+            current.requiredPlugins.map((selector) => (typeof selector === "string" ? { id: selector } : selector)),
+            send,
+          )
+          .pipe(
+            Effect.catchIf(
+              (error): error is Plugin.RequiredPluginError => error instanceof Plugin.RequiredPluginError,
+              (error) =>
+                Effect.die(
+                  denied("REQUIRED_PLUGIN_INACTIVE", error.message, [
+                    "Activate the required plugin generation and retry.",
+                    "Check the host log for plugin setup or transform failures.",
+                  ]),
+                ),
+            ),
+          )
+      })
+
+    return Service.of({ assertExecutionAllowed, assertProviderRequest, withProviderSend })
+  }),
+)
+
+export const node = makeLocationNode({
+  service: Service,
+  layer,
+  deps: [Config.node, FSUtil.node],
+})
