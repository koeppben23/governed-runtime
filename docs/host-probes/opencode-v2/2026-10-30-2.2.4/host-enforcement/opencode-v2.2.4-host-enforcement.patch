diff --git a/packages/core/test/host-policy.test.ts b/packages/core/test/host-policy.test.ts
new file mode 100644
index 0000000..32ffc8c
--- /dev/null
+++ b/packages/core/test/host-policy.test.ts
@@ -0,0 +1,242 @@
+import { expect } from "bun:test"
+import { Config } from "@opencode/core/config"
+import { ConfigManaged } from "@opencode/core/config/managed"
+import { HostPolicy } from "@opencode/core/host-policy"
+import { Plugin } from "@opencode/core/plugin/service"
+import { ConfigHost } from "@opencode/schema/config/host"
+import { Info } from "@opencode/schema/config"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Effect, Exit, Layer, Stream } from "effect"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(Layer.empty)
+
+const managed = (
+  providerExecution: ConfigHost.ProviderExecution,
+  requiredPlugins?: ReadonlyArray<ConfigHost.RequiredPlugin>,
+) =>
+  new ConfigManaged.Document({
+    type: "document",
+    info: new Info({ providerExecution, requiredPlugins }),
+  })
+
+const configLayer = (
+  providerExecution: ConfigHost.ProviderExecution,
+  requiredPlugins?: ReadonlyArray<ConfigHost.RequiredPlugin>,
+) =>
+  Layer.succeed(
+    Config.Service,
+    Config.Service.of({
+      entries: () => Effect.succeed([managed(providerExecution, requiredPlugins)]),
+      changes: () => Stream.never,
+      compatibility: () => Effect.succeed({ claude: [], agents: [] }),
+    }),
+  )
+
+const fsLayer = Layer.succeed(FSUtil.Service, {} as FSUtil.Interface)
+
+const policyLayer = (
+  providerExecution: ConfigHost.ProviderExecution,
+  requiredPlugins?: ReadonlyArray<ConfigHost.RequiredPlugin>,
+) => HostPolicy.layer.pipe(Layer.provide(Layer.merge(configLayer(providerExecution, requiredPlugins), fsLayer)))
+
+const policy = new ConfigHost.ProviderExecution({
+  allowedProviders: ["probe"],
+  hostedTools: "deny",
+})
+
+const securePolicy = new ConfigHost.ProviderExecution({
+  allowedProviders: [
+    {
+      id: "probe",
+      baseURL: "https://probe.invalid:8443/v1",
+      transports: ["http", "websocket"],
+    },
+  ],
+  hostedTools: "deny",
+})
+
+const endpointPolicy = new ConfigHost.ProviderExecution({
+  allowedProviders: [
+    {
+      id: "probe",
+      package: "probe-package",
+      baseURL: "https://probe.invalid/v1",
+      transports: ["http"],
+    },
+  ],
+  hostedTools: "deny",
+})
+
+it.effect("rejects a hosted tool definition before the provider request", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const result = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        url: "https://probe.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [{ type: "web_search" }] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    expect(Exit.isFailure(result)).toBe(true)
+  }).pipe(Effect.provide(policyLayer(policy))),
+)
+
+it.effect("rejects a hosted WebSocket frame before the socket send", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const result = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        package: "probe-package",
+        url: "wss://probe.invalid/v1/responses",
+        body: JSON.stringify({ tools: [{ type: "web_search" }] }),
+        transport: "websocket",
+      })
+      .pipe(Effect.exit)
+    expect(Exit.isFailure(result)).toBe(true)
+  }).pipe(Effect.provide(policyLayer(policy))),
+)
+
+it.effect("allows a function tool definition and rejects a provider outside the allowlist", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const allowed = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        url: "https://probe.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [{ type: "function", name: "read" }] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    const denied = yield* host
+      .assertProviderRequest({
+        providerID: "other",
+        url: "https://probe.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    expect(Exit.isSuccess(allowed)).toBe(true)
+    expect(Exit.isFailure(denied)).toBe(true)
+  }).pipe(Effect.provide(policyLayer(policy))),
+)
+
+it.effect("rechecks the required plugin at the final provider send", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const plugins = Plugin.Service.of({
+      activate: () => Effect.void,
+      list: () => Effect.succeed([]),
+      requireActive: () =>
+        Effect.fail(
+          new Plugin.RequiredPluginError({
+            plugin: "flowguard.host-probe",
+            message: "required plugin inactive",
+          }),
+        ),
+      withActive: (_selectors, effect) => effect,
+      gui: () => Effect.succeed(undefined),
+      close: () => Effect.void,
+      awaitActivation: Effect.void,
+      hold: () => Effect.succeed(Effect.void),
+    })
+    const result = yield* host
+      .assertProviderRequest(
+        {
+          providerID: "probe",
+          url: "https://probe.invalid/v1/chat/completions",
+          body: JSON.stringify({ tools: [{ type: "function", name: "read" }] }),
+          transport: "http",
+        },
+        plugins,
+      )
+      .pipe(Effect.exit)
+    expect(Exit.isFailure(result)).toBe(true)
+  }).pipe(Effect.provide(policyLayer(policy, [{ id: "flowguard.host-probe" }]))),
+)
+
+it.effect("fails closed when a required plugin service is absent", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const result = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        url: "https://probe.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    expect(Exit.isFailure(result)).toBe(true)
+  }).pipe(Effect.provide(policyLayer(policy, [{ id: "flowguard.host-probe" }]))),
+)
+
+it.effect("pins the provider endpoint and transport", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const allowed = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        package: "probe-package",
+        url: "https://probe.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    const wrongPackage = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        package: "other-package",
+        url: "https://probe.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    const wrongHost = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        package: "probe-package",
+        url: "https://evil.invalid/v1/chat/completions",
+        body: JSON.stringify({ tools: [] }),
+        transport: "http",
+      })
+      .pipe(Effect.exit)
+    const wrongTransport = yield* host
+      .assertProviderRequest({
+        providerID: "probe",
+        package: "probe-package",
+        url: "wss://probe.invalid/v1/responses",
+        body: JSON.stringify({ tools: [] }),
+        transport: "websocket",
+      })
+      .pipe(Effect.exit)
+    expect(Exit.isSuccess(allowed)).toBe(true)
+    expect(Exit.isFailure(wrongPackage)).toBe(true)
+    expect(Exit.isFailure(wrongHost)).toBe(true)
+    expect(Exit.isFailure(wrongTransport)).toBe(true)
+  }).pipe(Effect.provide(policyLayer(endpointPolicy))),
+)
+
+it.effect("does not downgrade an allowed secure endpoint", () =>
+  Effect.gen(function* () {
+    const host = yield* HostPolicy.Service
+    const cases = [
+      ["https", "https://probe.invalid:8443/v1/chat/completions", "http"],
+      ["http downgrade", "http://probe.invalid:8443/v1/chat/completions", "http"],
+      ["wss upgrade", "wss://probe.invalid:8443/v1/responses", "websocket"],
+      ["ws downgrade", "ws://probe.invalid:8443/v1/responses", "websocket"],
+    ] as const
+    const results = yield* Effect.forEach(cases, ([, url, transport]) =>
+      host
+        .assertProviderRequest({
+          providerID: "probe",
+          url,
+          body: JSON.stringify({ tools: [] }),
+          transport,
+        })
+        .pipe(Effect.exit),
+    )
+    expect(results.map(Exit.isSuccess)).toEqual([true, false, true, false])
+  }).pipe(Effect.provide(policyLayer(securePolicy))),
+)
