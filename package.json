{
  "name": "@flowguard/core",
  "version": "1.2.0-tp.2",
  "description": "Host-aware governance runtime for AI-assisted software delivery — deterministic, fail-closed, audit-ready workflow engine.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integration": {
      "import": "./dist/integration/index.js",
      "types": "./dist/integration/index.d.ts"
    },
    "./integration/tools": {
      "import": "./dist/integration/tools/index.js",
      "types": "./dist/integration/tools/index.d.ts"
    },
    "./integration/plugin": {
      "import": "./dist/integration/plugin.js",
      "types": "./dist/integration/plugin.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./tsa": "./dist/tsa.js"
  },
  "bin": {
    "flowguard": "./dist/cli/install.js",
    "flowguard-mcp": "./dist/mcp-server/index.js",
    "flowguard-hook-pre": "./dist/hooks/pre-tool-use.js",
    "flowguard-hook-post": "./dist/hooks/post-tool-use.js",
    "flowguard-hook-session": "./dist/hooks/session-start.js",
    "flowguard-hook-stop": "./dist/hooks/stop.js",
    "flowguard-hook-server": "./dist/hooks/http-server.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "build": "npm run clean && npm run sync-version && npm run generate-docs && tsc && npm run generate-doc-inventory && npm run generate-build-info",
    "check:esm": "node scripts/check-esm-imports.js",
    "check:agent-instructions": "node scripts/check-agent-instructions.mjs",
    "check:actions-pinned": "node scripts/check-github-actions-pinned.js",
    "check:node-toolchain": "node scripts/check-node-toolchain-consistency.mjs",
    "check:prod": "tsc --noEmit -p tsconfig.json",
    "check:tests": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run check:prod && npm run check:tests && npm run check:agent-instructions",
    "typecheck": "npm run check",
    "check:opencode-host": "node scripts/check-opencode-host-drift.mjs",
    "check:unused-dependencies": "knip --dependencies",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:strict": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"docs/**/*.md\" \"demos/**/*.md\" \"scripts/**/*.js\" \"*.json\" \".github/**/*.yml\"",
    "check:format": "prettier --check \"src/**/*.ts\" \"docs/**/*.md\" \"demos/**/*.md\" \"scripts/**/*.js\" \"*.json\" \".github/**/*.yml\"",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "test": "vitest run --project unit --project integration",
    "test:coverage": "node scripts/coverage.mjs",
    "test:coverage:ci": "node scripts/coverage.mjs --ci",
    "test:watch": "vitest --project unit --project integration",
    "test:install-verify": "vitest run --project smoke src/cli/install-verify.test.ts",
    "test:claude-plugin-load": "vitest run --project smoke src/cli/claude-plugin-load.test.ts",
    "test:opencode-reviewer-capabilities": "vitest run --project smoke src/cli/opencode-reviewer-capability.test.ts",
    "test:acp": "vitest run --project smoke src/cli/run-acp-smoke.test.ts",
    "test:review-validation-host-contract": "vitest run --project integration src/integration/review-validation-host-contract.test.ts",
    "test:review-modeb-contract": "vitest run --project integration src/integration/review-modeb-contract.test.ts",
    "test:e2e-contract": "vitest run --project integration src/integration/runtime-flow-e2e-contract.test.ts",
    "test:unit": "vitest run --project unit",
    "test:architecture": "vitest run --project unit src/architecture/",
    "test:integration": "vitest run --project integration",
    "test:integration:perf": "vitest run --project integration --testNamePattern 'PERF'",
    "test:sdk-contract": "vitest run --project integration src/integration/sdk-contract.test.ts",
    "test:sdk-contract:hooks": "vitest run --project integration src/integration/sdk-contract-hooks.test.ts",
    "test:sdk-contract:mcp": "vitest run --project integration src/integration/sdk-contract-mcp.test.ts",
    "test:sdk-contract:governance": "vitest run --project integration src/integration/sdk-contract-governance.test.ts",
    "test:sdk-contract:plugin": "vitest run --project integration src/integration/sdk-contract-plugin.test.ts",
    "test:sdk-contract:runtime": "vitest run --project integration src/integration/sdk-contract-runtime.test.ts",
    "test:sdk-contract:all": "vitest run --project integration src/integration/sdk-contract*.test.ts",
    "test:smoke": "vitest run --project smoke",
    "test:fuzz": "vitest run --project fuzz",
    "test:fuzz:deep": "FAST_CHECK_NUM_RUNS=10000 vitest run --project fuzz",
    "test:assertion-conformance": "vitest run --project conformance test/conformance/assertions/assertion-golden-conformance.test.ts",
    "test:provider-conformance": "FLOWGUARD_RUNTIME_CONFORMANCE=1 vitest run --project conformance test/conformance/assertions/assertion-runtime-conformance.test.ts",
    "test:independent-review-e2e": "node scripts/verify-independent-review-e2e.js",
    "trigger:opencode-host-update": "node scripts/check-opencode-host-drift.mjs --trigger",
    "sync-version": "node scripts/sync-version.js",
    "update:opencode-sdk": "node scripts/update-opencode-sdk.mjs",
    "generate-docs": "node scripts/generate-docs.js",
    "generate-build-info": "node scripts/generate-build-info.js",
    "generate-doc-inventory": "node scripts/generate-doc-inventory.mjs",
    "check:doc-drift": "npm run build && npm run generate-doc-inventory && git diff --exit-code docs/_inventory.generated.md && npx vitest run --project unit src/documentation/__tests__/product-inventory.test.ts src/documentation/__tests__/comment-count-drift.test.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "mutation": "node scripts/stryker-patch.js && stryker run",
    "pack:checksums": "node scripts/pack-with-checksums.js",
    "release:prepare": "node scripts/prepare-release.js",
    "setup-hooks": "node scripts/setup-git-hooks.js",
    "prepare": "npm run setup-hooks",
    "release:verify": "npm run check && npm run lint && npm test && npm run build && npm run check:esm && npm run test:install-verify",
    "release:assert-main-tag": "node scripts/assert-main-release-tag.js"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0",
    "npm": "^10.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.2",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@opentelemetry/api": "^1.9.1",
    "asn1js": "^3.0.10",
    "jose": "^6.2.10",
    "jsonc-parser": "^3.3.1",
    "pkijs": "^3.4.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.37.0",
    "@opencode-ai/plugin": "1.18.25",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.8.0",
    "knip": "^6.32.3",
    "prettier": "^3.9.4",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "qs": "6.16.0",
    "fast-uri": "3.1.7",
    "protobufjs": "7.6.5"
  },
  "files": [
    "dist",
    "VERSION"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
