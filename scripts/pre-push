#!/usr/bin/env bash
set -euo pipefail

# Managed by FlowGuard setup-git-hooks. Local edits may be overwritten.

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "[pre-push] Running npm run check:format..."

if npm run check:format; then
  echo -e "${GREEN}[pre-push] Formatting OK${NC}"
else
  echo -e "${RED}[pre-push] Formatting errors found. Run 'npm run format' to fix, then commit and push again.${NC}"
  exit 1
fi
