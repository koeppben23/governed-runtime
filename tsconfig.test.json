{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.stryker.config.ts",
    "vitest.stryker-human-projection.config.ts",
    "vitest.stryker-identity-jwks.config.ts",
    "vitest.mandates.config.ts",
    "vitest.stryker-schemas.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "dist", ".opencode", "test/conformance/assertions/projects"]
}
