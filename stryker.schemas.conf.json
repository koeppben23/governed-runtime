{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker-schemas.config.ts",
    "related": false
  },
  "mutate": ["src/config/flowguard-config.ts"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "coverageAnalysis": "all",
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "concurrency": 2,
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutator": {
    "excludedMutations": ["StringLiteral", "ArrayDeclaration", "Regex"]
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp-schemas",
  "ignoreStatic": false,
  "jsonReporter": {
    "fileName": "reports/mutation/schemas/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/schemas/mutation.html"
  }
}
