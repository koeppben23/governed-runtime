{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance/host-adapter-interface",
  "title": "HostAdapter Interface Contract",
  "description": "Pinned minimal HAI. Contains only ports the product actually invokes; no static capability table, platform enum or reviewer-spawn claim.",
  "type": "object",
  "required": ["initialize", "shutdown", "getSession", "readHistory", "log"],
  "properties": {
    "initialize": {
      "type": "string",
      "const": "() => Promise<void>"
    },
    "shutdown": {
      "type": "string",
      "const": "() => Promise<void>"
    },
    "getSession": {
      "type": "string",
      "const": "(sessionId) => Promise<HostSession>"
    },
    "readHistory": {
      "type": "string",
      "const": "(sessionId) => Promise<unknown>"
    },
    "log": {
      "type": "string",
      "const": "(level, message, data?) => void"
    }
  },
  "$defs": {
    "HostSession": {
      "type": "object",
      "required": ["sessionId", "directory"],
      "properties": {
        "sessionId": { "type": "string" },
        "parentSessionId": { "type": "string" },
        "directory": { "type": "string" },
        "agent": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
