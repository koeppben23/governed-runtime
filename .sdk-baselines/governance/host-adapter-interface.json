{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance/host-adapter-interface",
  "title": "HostAdapter Interface Contract",
  "description": "Pinned shape of the HostAdapter interface (HAI). Review capabilities are transport-bound and must not be composed across different transports.",
  "type": "object",
  "required": [
    "platform",
    "capabilities",
    "enforcementLevel",
    "getWorkingDirectory",
    "getWorktree",
    "initialize",
    "validateCapabilities",
    "shutdown",
    "deliverBlockDecision",
    "deliverArgMutation",
    "mutateToolResult",
    "spawnReviewer",
    "isReviewerSupported",
    "log"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["opencode", "claude-code", "codex"]
    },
    "capabilities": { "$ref": "#/$defs/HostCapabilities" },
    "enforcementLevel": {
      "type": "string",
      "enum": ["synchronous", "hook_gated", "advisory"]
    },
    "getWorkingDirectory": { "type": "string", "const": "() => string" },
    "getWorktree": { "type": "string", "const": "() => string" },
    "initialize": { "type": "string", "const": "() => Promise<void>" },
    "validateCapabilities": {
      "type": "string",
      "const": "() => Promise<CapabilityValidationResult>"
    },
    "shutdown": { "type": "string", "const": "() => Promise<void>" },
    "deliverBlockDecision": { "type": "string", "const": "(event, decision) => void" },
    "deliverArgMutation": { "type": "string", "const": "(event, args) => void" },
    "mutateToolResult": { "type": "string", "const": "(event, mutation) => void" },
    "spawnReviewer": {
      "type": "string",
      "const": "(config) => Promise<HostReviewerResult | null>"
    },
    "isReviewerSupported": { "type": "string", "const": "() => boolean" },
    "log": { "type": "string", "const": "(level, message, data?) => void" },
    "injectCompactionContext": { "type": "string", "const": "(context) => void" }
  },
  "$defs": {
    "HostCapabilities": {
      "type": "object",
      "required": [
        "preToolBlock",
        "argMutation",
        "outputReplacement",
        "contextInjection",
        "reviewTransports",
        "compactionInjection"
      ],
      "properties": {
        "preToolBlock": { "type": "boolean" },
        "argMutation": { "type": "boolean" },
        "outputReplacement": { "type": "boolean" },
        "contextInjection": { "type": "boolean" },
        "reviewTransports": {
          "type": "array",
          "items": { "$ref": "#/$defs/HostReviewTransportCapability" }
        },
        "compactionInjection": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "HostReviewTransportCapability": {
      "type": "object",
      "required": [
        "kind",
        "structuredOutput",
        "parentVisible",
        "transcriptNavigable",
        "isolatedAgentIdentity",
        "permissionIsolation",
        "assurance"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["native_task_structured_followup"]
        },
        "structuredOutput": { "type": "boolean", "const": true },
        "parentVisible": { "type": "boolean", "const": true },
        "transcriptNavigable": { "type": "boolean", "const": true },
        "isolatedAgentIdentity": { "type": "boolean", "const": true },
        "permissionIsolation": { "type": "boolean", "const": true },
        "assurance": {
          "type": "string",
          "const": "structured_high"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
