{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "all",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.stryker-event-core.config.ts",
    "related": false
  },
  "mutate": ["src/audit/event-core.ts"],
  "mutator": {
    "excludedMutations": ["ArrayDeclaration", "Regex"]
  },
  "ignoreStatic": false,
  "thresholds": {
    "high": 95,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp-event-core"
}
