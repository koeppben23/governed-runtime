{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker-review-capture.config.ts", "related": false },
  "mutate": [
    "src/integration/reviewer-capture.ts",
    "src/integration/review/dispatch/structured-followup.ts",
    "src/integration/review/dispatch/provider-error.ts",
    "src/integration/review/dispatch/reviewer-task-completion.ts",
    "src/shared/strict-json-object.ts",
    "src/state/review-message-capture.ts"
  ],
  "reporters": ["clear-text", "html", "json"],
  "coverageAnalysis": "perTest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "concurrency": 3,
  "mutator": { "excludedMutations": ["StringLiteral", "ArrayDeclaration", "Regex"] },
  "ignoreStatic": true,
  "thresholds": { "high": 85, "low": 80, "break": 80 },
  "jsonReporter": { "fileName": "reports/mutation/review-capture/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/review-capture/mutation.html" }
}
