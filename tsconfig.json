{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".opencode",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/*-test-helpers.ts",
    "**/test-helpers.ts",
    "**/*-test-fixtures.ts",
    "**/evidence-test-constants.ts",
    "src/fixtures.ts",
    "src/fixtures/**",
    "src/test-policy.ts",
    "src/architecture/**",
    "src/documentation/**",
    "src/security/**"
  ]
}
