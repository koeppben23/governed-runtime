{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "json"],
  "coverageAnalysis": "perTest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.stryker-identity-jwks.config.ts"
  },
  "mutate": [
    "src/identity/key-resolver.ts:270-277",
    "src/identity/key-resolver.ts:328-334",
    "src/identity/key-resolver.ts:338-350"
  ],
  "mutator": {
    "excludedMutations": ["ArrayDeclaration", "Regex"]
  },
  "ignoreStatic": true,
  "thresholds": {
    "high": 85,
    "low": 80,
    "break": 80
  }
}
